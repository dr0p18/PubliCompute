     // a stage [layer_start, layer_end) loads only its own tensors (see llama_model_base::create_tensor): the token
-    // embeddings on the head, the final norm and the output head on the tail; the MTP block is never part of a stage
-    if (stage_partial() && ml.load_mtp) {
