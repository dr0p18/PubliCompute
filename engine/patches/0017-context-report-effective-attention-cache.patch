diff --git a/src/llama-kv-cache.h b/src/llama-kv-cache.h
index 9ed36c562a45c6cb623956a7be3bb199ca3545e4..71d5bb05521e232a5c829e6d71f91415baf3dbf1 100644
--- a/src/llama-kv-cache.h
+++ b/src/llama-kv-cache.h
@@ -164,6 +164,21 @@ public:
     ggml_type type_k() const;
     ggml_type type_v() const;
 
+    void add_attention_cache_types(llama_attention_cache_info & info) const {
+        for (const auto & layer : layers) {
+            const ggml_type k = layer.k->type;
+            const ggml_type v = layer.v ? layer.v->type : k;
+            if (info.has_attention_cache) {
+                info.type_k = info.type_k == k ? k : GGML_TYPE_COUNT;
+                info.type_v = info.type_v == v ? v : GGML_TYPE_COUNT;
+            } else {
+                info.type_k = k;
+                info.type_v = v;
+                info.has_attention_cache = true;
+            }
+        }
+    }
+
     std::vector<uint32_t> get_layer_ids() const;
     ggml_tensor * get_k_storage(int32_t il) const;
 
