+static void llama_read_attention_cache_types(const llama_memory_i * memory, llama_attention_cache_info & info) {
+    if (const auto * cache = dynamic_cast<const llama_kv_cache *>(memory)) {
+        cache->add_attention_cache_types(info);
+    } else if (const auto * cache = dynamic_cast<const llama_kv_cache_iswa *>(memory)) {
+        llama_read_attention_cache_types(cache->get_base(), info);
+        llama_read_attention_cache_types(cache->get_swa(), info);
+    } else if (const auto * cache = dynamic_cast<const llama_memory_hybrid *>(memory)) {
+        llama_read_attention_cache_types(cache->get_mem_attn(), info);
+    } else if (const auto * cache = dynamic_cast<const llama_memory_hybrid_iswa *>(memory)) {
+        llama_read_attention_cache_types(cache->get_mem_attn(), info);
+    } else if (const auto * cache = dynamic_cast<const llama_kv_cache_msa *>(memory)) {
+        llama_read_attention_cache_types(cache->get_base(), info);
+    } else if (const auto * cache = dynamic_cast<const llama_kv_cache_dsa *>(memory)) {
+        llama_read_attention_cache_types(cache->get_mla(), info);
+    } else if (const auto * cache = dynamic_cast<const llama_kv_cache_dsa_iswa *>(memory)) {
+        llama_read_attention_cache_types(cache->get_dsa(), info);
+        llama_read_attention_cache_types(cache->get_swa(), info);
+    } else if (const auto * cache = dynamic_cast<const llama_kv_cache_dsv4 *>(memory)) {
+        llama_read_attention_cache_types(cache->get_raw(), info);
+        llama_read_attention_cache_types(cache->get_csa(), info);
+        llama_read_attention_cache_types(cache->get_hca(), info);
+    }
+}
+
+llama_attention_cache_info llama_get_attention_cache_info(const llama_context * ctx) {
+    if (!ctx) {
+        return { GGML_TYPE_COUNT, GGML_TYPE_COUNT, false, false };
+    }
+
+    llama_attention_cache_info info = { GGML_TYPE_COUNT, GGML_TYPE_COUNT, ctx->get_cparams().flash_attn, false };
+    llama_read_attention_cache_types(ctx->get_memory(), info);
+    return info;
+}
