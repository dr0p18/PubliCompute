+// Compare the per-step logits of two sequences that share a batch.
+// Use tokens from the single-sequence runs to keep each compared prefix fixed.
+static void batch2(Chain & ch, const std::vector<llama_token> & t0, const std::vector<llama_token> & t1,
+                   const Run & r0, const Run & r1, int n4, B2 & r, bool all_out = false, bool sep_prefill = false) {
+    reset_chain(ch);
+    r.l0.clear(); r.l1.clear();
+    std::vector<Row> rows; std::vector<std::vector<float>> out;
+    for (size_t i = 0; i < t0.size(); ++i) rows.push_back({t0[i], (llama_pos) i, 0, all_out || i + 1 == t0.size()});
+    for (size_t i = 0; i < t1.size(); ++i) rows.push_back({t1[i], (llama_pos) i, 1, all_out || i + 1 == t1.size()});
+    bool ok = true;
+    std::vector<float> first0, first1; // Retain the last logits of each sequence when their prefill calls are separate.
+    if (sep_prefill) {
+        std::vector<Row> ra(rows.begin(), rows.begin() + t0.size()), rb(rows.begin() + t0.size(), rows.end());
+        ok = chain_decode(ch, ra, out); if (ok) first0 = out[all_out ? t0.size() - 1 : 0];
+        ok = ok && chain_decode(ch, rb, out); if (ok) first1 = out[all_out ? t1.size() - 1 : 0];
+        out.clear(); out.push_back(first0); out.push_back(first1);
+        all_out = false;
+    } else ok = chain_decode(ch, rows, out);
+    size_t i0 = 0, i1 = 1; // Track the positions of the two comparison rows when additional outputs are enabled.
+    if (all_out) { i0 = t0.size() - 1; i1 = t0.size() + t1.size() - 1; }
+    llama_pos p0 = (llama_pos) t0.size(), p1 = (llama_pos) t1.size();
+    for (int s = 0; ok && s < n4; ++s) {
+        r.l0.push_back(out[i0]); r.l1.push_back(out[i1]); i0 = 0; i1 = 1;
+        if (s + 1 == n4) break;
+        rows = {{r0.toks[s], p0++, 0, true}, {r1.toks[s], p1++, 1, true}};
+        ok = chain_decode(ch, rows, out);
+    }
+    r.ok = ok;
+}
