+// Verify a draft in one batch, then keep only its first proposed token.
+// Roll back the remaining rows on every stage in one operation, since
+// the recurrent snapshot can be consumed only once. Continue greedy
+// decoding from the retained prefix.
+static bool p_rollback(Chain & c, const std::vector<llama_token> & prompt, int K, int n_after, Logs & l, bool & rm_ok,
+                       std::vector<llama_token> & acc) {
+    reset_chain(c);
+    acc.clear();
+    Logs out;
+    std::vector<Row> rows;
+    for (size_t i = 0; i < prompt.size(); ++i) rows.push_back({prompt[i], (llama_pos) i, 0, i + 1 == prompt.size()});
+    if (!chain_decode(c, rows, out)) return false;
+    l.push_back(out[0]);
+    const llama_pos L = (llama_pos) prompt.size();
+    const llama_token t0 = argmax(out[0]);
+    rows = {{t0, L, 0, true}};
+    for (int i = 1; i <= K; ++i) rows.push_back({(llama_token) ((t0 + 97 * i) % c.n_vocab), L + i, 0, true}); // Generate deterministic draft tokens to give both paths the same batch input.
+    if (!chain_decode(c, rows, out)) return false;
+    for (const auto & v : out) l.push_back(v);
+    acc = {rows[0].tok, rows[1].tok};                        // Keep the verified prefix and the first accepted proposal.
+    for (auto & s : c.st) rm_ok = llama_memory_seq_rm(llama_get_memory(s.ctx), 0, L + 2, -1) && rm_ok; // Remove rejected positions from every stage before resuming decode.
+    const llama_token x = argmax(out[1]);                    // Resume from the distribution at the last accepted row.
+    acc.push_back(x);
+    llama_pos pos = L + 2;
+    rows = {{x, pos++, 0, true}};
+    for (int s = 0; s < n_after; ++s) {
+        if (!chain_decode(c, rows, out)) return false;
+        l.push_back(out[0]);
+        if (s + 1 < n_after) { acc.push_back(argmax(out[0])); rows = {{acc.back(), pos++, 0, true}}; }
+    }
+    return true;
+}
+
+// Replay the retained tokens step by step to get a reference without rollback.
+static bool run_without_draft(Chain & c, const std::vector<llama_token> & prompt, const std::vector<llama_token> & acc, Logs & l) {
+    reset_chain(c);
+    Logs out;
+    std::vector<Row> rows;
+    for (size_t i = 0; i < prompt.size(); ++i) rows.push_back({prompt[i], (llama_pos) i, 0, i + 1 == prompt.size()});
+    if (!chain_decode(c, rows, out)) return false;
+    llama_pos pos = (llama_pos) prompt.size();
+    for (size_t i = 0; i < acc.size(); ++i) {
+        rows = {{acc[i], pos++, 0, true}};
+        if (!chain_decode(c, rows, out)) return false;
+        if (i >= 2) l.push_back(out[0]);                    // Compare only the logits after the retained prefix.
+    }
+    return true;
+}
+
+struct RollRef { std::vector<Logs> l, plain; std::vector<std::vector<llama_token>> acc; bool rm_ok = true; };
+
+static bool roll_run(Chain & c, const std::vector<std::vector<llama_token>> & TT, int K, int n_after, RollRef & r) {
+    r.l.assign(3, {}); r.plain.assign(3, {}); r.acc.assign(3, {});
+    for (int p = 0; p < 3; ++p) {
+        if (!p_rollback(c, TT[p], K, n_after, r.l[p], r.rm_ok, r.acc[p])) return false;
+        if (!run_without_draft(c, TT[p], r.acc[p], r.plain[p])) return false;
+    }
+    return true;
+}
+
+// Report numerical differences from the stepwise reference, whose batch shape differs.
+static void roll_vs_plain(const RollRef & R, int & ad, int & n, double & md) {
+    ad = 0; n = 0; md = 0;
+    for (int p = 0; p < 3; ++p) for (size_t i = 0; i < R.plain[p].size(); ++i, ++n) {
+        const auto & a = R.l[p][R.l[p].size() - R.plain[p].size() + i];
+        const auto & b = R.plain[p][i];
+        ad += argmax(a) != argmax(b); md = std::max(md, max_abs_diff(a, b));
+    }
+}
+
+static int rollback_suite(const char * path, Chain & ref, int n_layer, const std::vector<int> & cuts, const std::vector<int> & three_stage_cuts, int K) {
+    int fails = 0;
+    const int n_after = 8;
+    std::vector<std::vector<llama_token>> TT(3);
+    for (int p = 0; p < 3; ++p) TT[p] = tok(ref.st[0].model, PROMPTS[p]);
+    printf("rollback: %d draft tokens (1 kept, %d removed with seq_rm), n_rs_seq = %d, %d steps after rollback\n", K, K - 1, g_rs_seq, n_after);
+    RollRef R;
+    if (!roll_run(ref, TT, K, n_after, R)) { printf("rollback: reference decode failed\n"); return 1; }
+    printf("  Reference: seq_rm %s\n", R.rm_ok ? "accepted" : "rejected");
+    if (!R.rm_ok) fails++;
+    {   int ad, n; double md;
+        roll_vs_plain(R, ad, n, md);
+        printf("  Reference with and without rollback (diagnostic): %d logit rows, %d argmax differences, maximum difference %.3g\n", n, ad, md); }
+    free_chain(ref);
+
+    std::vector<std::vector<int>> cfg;
+    for (int k : cuts) cfg.push_back({k});
+    if (three_stage_cuts.size() == 2) cfg.push_back(three_stage_cuts);
+    for (const auto & cuts : cfg) {
+        std::vector<int> b = {0}; b.insert(b.end(), cuts.begin(), cuts.end()); b.push_back(n_layer);
+        std::string name;
+        for (size_t i = 0; i + 1 < b.size(); ++i) { char t[32]; snprintf(t, sizeof t, "%s[%d,%d)", i ? "+" : "", b[i], b[i + 1]); name += t; }
+        printf("  Chain %s:\n", name.c_str());
+        Chain ch; ch.st.resize(b.size() - 1); ch.n_vocab = ref.n_vocab;
+        bool ok = true;
+        for (size_t i = 0; ok && i + 1 < b.size(); ++i) {
+            ok = load_stage(ch.st[i], path, b[i], b[i + 1], 2, true);
+            ch.st[i].tail = i + 2 == b.size();
+        }
+        if (!ok) { printf("    FAIL: could not load stage\n"); fails++; free_chain(ch); continue; }
+        RollRef C;
+        if (!roll_run(ch, TT, K, n_after, C)) { printf("    FAIL: decode failed\n"); fails++; free_chain(ch); continue; }
+        int nd = 0, n = 0; double md = 0;
+        for (int p = 0; p < 3; ++p) {
+            if (R.l[p].size() != C.l[p].size()) { nd++; continue; }
+            for (size_t i = 0; i < R.l[p].size(); ++i, ++n) {
+                nd += !bit_equal(R.l[p][i], C.l[p][i]); md = std::max(md, max_abs_diff(R.l[p][i], C.l[p][i]));
+            }
+        }
+        printf("    %-58s %s: %d logit rows compared, %d differ, maximum difference %.3g\n", "draft, rollback and subsequent steps against reference", nd ? "FAIL" : "OK", n, nd, md);
+        printf("    %-58s %s\n", "all stages accepted seq_rm", C.rm_ok ? "OK" : "FAIL");
+        int ad, nn; double mp;
+        roll_vs_plain(C, ad, nn, mp);
+        printf("    %-58s (diagnostic): %d logit rows, %d argmax differences, maximum difference %.3g\n", "chain with and without rollback", nn, ad, mp);
+        fails += (nd != 0) + (!C.rm_ok);
+        free_chain(ch);
+    }
+    return fails;
+}
