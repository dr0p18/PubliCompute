+// Check the loader rejects invalid layer ranges and unsupported draft layouts.
+static int invalid_ranges_suite(const char * path, int n_layer, int n_nextn) {
+    int fails = 0;
+    auto prova = [&](const char * what, int a, int b, bool mtp, bool expected_ok) {
+        llama_model_params mp = llama_model_default_params();
+        mp.n_gpu_layers = 0; mp.layer_start = a; mp.layer_end = b; mp.load_mtp = mtp;
+        llama_model * m = llama_model_load_from_file(path, mp);
+        const bool ok = m != nullptr;
+        if (m) llama_model_free(m);
+        printf("  %-62s %s: %s\n", what, ok == expected_ok ? "OK" : "FAIL", ok ? "loaded" : "rejected");
+        return ok == expected_ok ? 0 : 1;
+    };
+    printf("invalid-ranges: n_layer = %d, auxiliary blocks = %d\n", n_layer, n_nextn);
+    fails += prova("empty range [3,3)", 3, 3, false, false);
+    fails += prova("reversed range [5,2)", 5, 2, false, false);
+    fails += prova("negative start [-1,4)", -1, 4, false, false);
+    fails += prova("end beyond the model [0,n+1)", 0, n_layer + 1, false, false);
+    fails += prova("valid head range [0,n-1)", 0, n_layer - 1, false, true);
+    if (n_nextn > 0) {
+        fails += prova("MTP with the full model (reference)", 0, -1, true, true);
+        fails += prova("MTP with head range [0,4)", 0, 4, true, false);
+        fails += prova("MTP with tail range [4,n)", 4, n_layer, true, false);
+        fails += prova("MTP with head range [0,n-1)", 0, n_layer - 1, true, false);
+    } else {
+        printf("  No MTP block in this model. Skipping MTP range cases.\n");
+    }
+    return fails;
+}
