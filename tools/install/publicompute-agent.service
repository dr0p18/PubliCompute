[Unit]
Description=PubliCompute agent
After=network-online.target
Wants=network-online.target

[Service]
User=publicompute-agent
Group=publicompute-agent
WorkingDirectory=/var/lib/publicompute-agent
RuntimeDirectory=publicompute-agent
RuntimeDirectoryMode=0750
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib
EnvironmentFile=/etc/publicompute-agent/agent.conf
LoadCredential=owner-token:/etc/publicompute-agent/owner-token
ExecStart=/opt/publicompute-agent/bin/publicompute-agent \
    --engine llama --llama-mode managed \
    --llama-bin /opt/publicompute-agent/bin/llama-server \
    --stage-bin /opt/publicompute-agent/bin/publicompute-stage \
    --model-path ${MODEL_PATH} --model-id ${MODEL_ID} --quantization ${QUANTIZATION} \
    --coordinator ${COORDINATOR} --server-name ${SERVER_NAME} --ca /etc/publicompute-agent/ca.pem \
    --data-dir /var/lib/publicompute-agent --control-socket /run/publicompute-agent/agent.sock \
    --owner-token-file ${CREDENTIALS_DIRECTORY}/owner-token
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=110s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/publicompute-agent
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
